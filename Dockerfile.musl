FROM alpine:edge AS builder

RUN apk add --no-cache \
    build-base \
    cmake \
    git \
    meson \
    ninja \
    linux-headers \
    pkgconf \
    patch \
    liburing-dev \
    mimalloc2-dev

WORKDIR /app

COPY . .

RUN if patch -R -p1 -d external/libfuse -s -f --dry-run -i /app/patches/libfuse-fixes.patch >/dev/null 2>&1; then \
        echo "libfuse patches already applied"; \
    else \
        patch -p1 -d external/libfuse -i /app/patches/libfuse-fixes.patch; \
    fi

RUN rm -rf external/libfuse/build && \
    meson setup external/libfuse external/libfuse/build \
        --default-library=static \
        --prefix=/usr \
        -Db_lto=true \
        -Dexamples=false \
        -Dtests=false \
        -Dutils=false && \
    ninja -C external/libfuse/build

RUN rm -rf /app/build && mkdir -p /app/build
WORKDIR /app/build

RUN cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-O2 -ffunction-sections -fdata-sections" \
    -DCMAKE_EXE_LINKER_FLAGS="-static -static-libstdc++ -static-libgcc -Wl,--gc-sections" \
    && make -j$(nproc)

RUN strip --strip-all -R .comment -R .note fusequota

FROM scratch AS export
COPY --from=builder /app/build/fusequota /fusequota_musl
